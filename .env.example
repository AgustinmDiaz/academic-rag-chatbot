# ==============================================================================
# Configuración de Variables de Entorno (Plantilla de Ejemplo)
# ==============================================================================
# IMPORTANTE:
# 1. Copia este archivo con el nombre '.env' en la raíz del proyecto.
# 2. Nunca subas tu archivo '.env' a GitHub ni lo compartas con terceros.
# 3. La API Key de Gemini se obtiene de forma 100% gratuita en https://aistudio.google.com/

# Clave de API de Google Gemini (Dejar en blanco si se configurará desde la interfaz gráfica)
GEMINI_API_KEY=

# Modelo a utilizar (la versión flash es rápida, precisa y con nivel gratuito amplio)
GEMINI_MODEL=gemini-1.5-flash
